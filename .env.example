# ── Copy to .env and fill your keys ─────────────────────
#   cp .env.example .env
#   nano .env

# Ollama (LLM for SILI answers). Leave empty to use built-in demo agent.
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=https://ollama.com

# ElevenLabs (high-quality voice). Leave empty to use free browser voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Admin password for publishing events/exams on the website
SOU_ADMIN_PASSWORD=admin123
